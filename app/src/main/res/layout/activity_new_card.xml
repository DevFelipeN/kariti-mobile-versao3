<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_night"
    tools:context="online.padev.kariti.CadProvaActivity">

    <include
        android:id="@+id/include"
        layout="@layout/appbarquestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="0dp" />

    <View
        android:id="@+id/divider4"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include" />


    <TextView
        android:id="@+id/textView8"
        style="@style/COLORTEXT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/textViewDataProva"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/datePickerNewCard"
        app:layout_constraintEnd_toStartOf="@+id/datePickerNewCard"
        app:layout_constraintHorizontal_bias="0.391"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/datePickerNewCard"
        app:layout_constraintVertical_bias="0.307" />

    <Button
        android:id="@+id/datePickerNewCard"
        style="@style/BUTTONSTYLE"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/buttonData"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/gridLayout3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.832"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextNameTeacher" />

    <EditText
        android:id="@+id/editTextNameProva"
        style="@style/CAMPOSEDITTEXT"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/borda_botao"
        android:ems="10"
        android:hint="@string/editTextNomeProva"
        android:importantForAutofill="no"
        android:inputType="text"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/editTextNameClass"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider4" />

    <EditText
        android:id="@+id/editTextNameClass"
        style="@style/CAMPOSEDITTEXT"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/borda_botao"
        android:hint="@string/editTextNameClass"
        android:inputType="text"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/editTextNameTeacher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextNameProva" />

    <EditText
        android:id="@+id/editTextNameTeacher"
        style="@style/CAMPOSEDITTEXT"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/borda_botao"
        android:hint="@string/editTextNameTeacher"
        android:inputType="text"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/datePickerNewCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextNameClass" />

    <Button
        android:id="@+id/btnNewCard"
        style="@style/BUTTONSTYLE"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/buttonGerarNewCard"
        android:textAlignment="center"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout3" />

    <GridLayout
        android:id="@+id/gridLayout3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:columnCount="4"
        android:rowCount="2"
        app:layout_constraintBottom_toTopOf="@+id/btnNewCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/datePickerNewCard">

        <TextView
            android:id="@+id/textView9"
            style="@style/COLORTEXT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_marginEnd="5dp"
            android:text="@string/textViewQuantQuestoes"
            android:textSize="16sp"
            tools:layout_editor_absoluteX="46dp"
            tools:layout_editor_absoluteY="358dp" />

        <ImageButton
            android:id="@+id/imageButtonMenosQuest"
            style="@style/COLORIMGICONE"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_row="0"
            android:layout_column="1"
            android:background="@color/tranparente"
            android:contentDescription="@string/iconeMenosQuast"
            app:srcCompat="@mipmap/subtract"
            tools:layout_editor_absoluteX="133dp"
            tools:layout_editor_absoluteY="332dp" />

        <EditText
            android:id="@+id/editTextQtdQuests"
            style="@style/COLORTEXT"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_row="0"
            android:layout_column="2"
            android:maxLength="2"
            android:paddingTop="10dp"
            android:inputType="number"
            android:text="@string/buttonQtd"
            android:textAlignment="center"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/imageButtonMaisQuest"
            style="@style/COLORIMGICONE"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/tranparente"
            android:contentDescription="@string/iconeAddMaisQuest"
            app:srcCompat="@mipmap/btnadicionar"
            tools:layout_editor_absoluteX="86dp"
            tools:layout_editor_absoluteY="267dp" />

        <TextView
            android:id="@+id/textView10"
            style="@style/COLORTEXT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp"
            android:text="@string/textViewQuantAltern"
            android:textSize="16sp"
            tools:layout_editor_absoluteX="46dp"
            tools:layout_editor_absoluteY="416dp" />

        <ImageButton
            android:id="@+id/imgBtnMenoAlter"
            style="@style/COLORIMGICONE"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@color/tranparente"
            android:contentDescription="@string/iconeMenosAlter"
            app:srcCompat="@mipmap/subtract"
            tools:layout_editor_absoluteX="133dp"
            tools:layout_editor_absoluteY="332dp" />

        <EditText
            android:id="@+id/editTextQtdAlters"
            style="@style/COLORTEXT"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:maxLength="2"
            android:inputType="number"
            android:paddingTop="10dp"
            android:text="@string/buttonQtd"
            android:textAlignment="center"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/imgBtnMaisAlter"
            style="@style/COLORIMGICONE"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@color/tranparente"
            android:contentDescription="@string/iconeAddMaisAlter"
            app:srcCompat="@mipmap/btnadicionar" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
